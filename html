<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday!</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="card-container">
        <h1 class="birthday-title" id="animatedTitle">HAPPY BIRTHDAY!</h1>
        
        <div class="gallery-card" id="galleryCard">
            <img id="memoryImage" src="memory1.jpg" alt="Special Birthday Memory">
            <p id="memoryCaption">The day we first met! Everything changed here.</p>
        </div>

        <button class="next-btn" onclick="nextMemory()">Tap for Next Memory ❤️</button>
    </div>

    <script href="script.js"></script>
</body>
</html>