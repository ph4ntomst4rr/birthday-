const colors = {
    carnationPink: 0xF7B3C2,  // Main frosting
    orchidPurple:  0x9F4C7D,  // Bottom shaded layer/inner sponge
    tallPoppyRed:  0xD22B2B,  // Red dividing rings/borders
    whiteCream:    0xF5F5F5   // Frosting dollops
};
const container = document.getElementById('cake-3d-container');
const scene = new THREE.Scene();

const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
camera.position.set(0, 5, 8); // Look slightly down onto the cake
camera.lookAt(0, 1, 0);

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(container.clientWidth, container.clientHeight);
container.appendChild(renderer.domElement);
const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
scene.add(ambientLight);

const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
directionalLight.position.set(5, 10, 7);
scene.add(directionalLight);
const cakeGroup = new THREE.Group();
function createMatteMaterial(colorValue) {
    return new THREE.MeshStandardMaterial({ color: colorValue, roughness: 0.6, metalness: 0.1 });
}
const bottomGeom = new THREE.CylinderGeometry(2, 2, 0.8, 32);
const bottomMesh = new THREE.Mesh(bottomGeom, createMatteMaterial(colors.orchidPurple));
bottomMesh.position.y = 0.4;
cakeGroup.add(bottomMesh);
const midRingGeom = new THREE.CylinderGeometry(2.05, 2.05, 0.15, 32);
const midRingMesh = new THREE.Mesh(midRingGeom, createMatteMaterial(colors.tallPoppyRed));
midRingMesh.position.y = 0.85;
cakeGroup.add(midRingMesh);
const topGeom = new THREE.CylinderGeometry(2, 2, 0.8, 32);
const topMesh = new THREE.Mesh(topGeom, createMatteMaterial(colors.carnationPink));
topMesh.position.y = 1.3;
cakeGroup.add(topMesh);
const topRingGeom = new THREE.CylinderGeometry(2.05, 2.05, 0.15, 32);
const topRingMesh = new THREE.Mesh(topRingGeom, createMatteMaterial(colors.tallPoppyRed));
topRingMesh.position.y = 1.75;
cakeGroup.add(topRingMesh);
const dollopCount = 8;
const radius = 1.5; // Positioning ring radius on top of the cake
for (let i = 0; i < dollopCount; i++) {
    const angle = (i / dollopCount) * Math.PI * 2;
    const dollopGeom = new THREE.ConeGeometry(0.2, 0.3, 16);
    const dollopMesh = new THREE.Mesh(dollopGeom, createMatteMaterial(colors.whiteCream));
    dollopMesh.position.x = Math.cos(angle) * radius;
    dollopMesh.position.z = Math.sin(angle) * radius;
    dollopMesh.position.y = 1.95; // Right on top of the red rim
    cakeGroup.add(dollopMesh);
}
scene.add(cakeGroup);
window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
});
function animate() {
    requestAnimationFrame(animate);
    cakeGroup.rotation.y += 0.01;
    renderer.render(scene, camera);
}
animate();
function nextMemory() {
    console.log("Button pressed!");
}
